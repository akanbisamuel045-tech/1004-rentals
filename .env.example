# =============================================
# Lagos Rentals — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================

# ---- Database ----
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lagos_rentals?schema=public"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-strong-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ---- Cloudinary (Image Storage) ----
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ---- Public env vars (safe to expose in browser) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# ---- Optional: Google OAuth ----
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
